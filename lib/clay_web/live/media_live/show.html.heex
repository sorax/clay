<Layouts.app flash={@flash} current_user={@current_user}>
  <.title back={~p"/medien"}>
    {@list.title}
    <:actions>
      <.button variant="primary" navigate={~p"/medien/#{@list}/neu"}>
        <.icon name="hero-plus" /> Neu
      </.button>
    </:actions>
  </.title>

  <.form :let={f} for={@filter} id="filter" phx-change="set_filter" phx-submit="set_filter">
    <.input
      field={f[:search]}
      type="search"
      placeholder="Suchbegriff"
      phx-debounce="400"
    />

    <div class="flex gap-2">
      <.input
        :for={{label, status} <- progress_options()}
        class="btn btn-sm"
        field={f[status]}
        type="checkbox"
        aria-label={label}
      />
    </div>
  </.form>

  <.book_list id="books" list_id={@list.id} books={@streams.books} />
</Layouts.app>
